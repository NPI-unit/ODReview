#!/bin/bash
# "ODReview installieren" — opens the installer window (tools/installer_gui.py).
# Before the window can exist it needs Python 3.12 and PySide6; this script
# brings both: Python is looked for (and asked for, natively, if missing),
# PySide6 comes from vendor/wheels or is downloaded into it first.
APPDIR="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APPDIR")"
cd "$ROOT" || exit 1
LOG="$ROOT/install.log"
export PIP_DISABLE_PIP_VERSION_CHECK=1
echo "== installer app $(date '+%Y-%m-%d %H:%M') ==" >> "$LOG"

say() {   # native dialog; $1 text, $2 extra button (opens python.org)
    if [ -n "${2:-}" ]; then
        r=$(osascript -e "display dialog \"$1\" with title \"ODReview installieren\" buttons {\"Abbrechen\", \"$2\"} default button 2 with icon caution" 2>/dev/null)
        case "$r" in *"$2"*) open "https://www.python.org/downloads/macos/";; esac
    else
        osascript -e "display dialog \"$1\" with title \"ODReview installieren\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1
    fi
}

# Downloaded folders carry the quarantine flag: lift it once, so the scripts
# and apps inside stop warning (opening this app was the user's consent).
xattr -dr com.apple.quarantine "$ROOT" 2>/dev/null || true

PY=""
for p in "$ROOT/vendor/python/bin/python3.12" /opt/homebrew/bin/python3.12 /usr/local/bin/python3.12 \
         /Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12 "$(command -v python3.12 2>/dev/null)"; do
    if [ -n "$p" ] && [ -x "$p" ] && "$p" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 12))' 2>/dev/null; then
        PY="$p"; break
    fi
done
if [ -z "$PY" ]; then
    say "Python 3.12 fehlt.\n\nBitte den macOS-Installer von python.org laden und doppelklicken (oder im Terminal: brew install python@3.12). Danach ODReview installieren erneut öffnen." "python.org öffnen"
    exit 1
fi

if ! [ -x "$ROOT/.venv/bin/python" ] || ! "$ROOT/.venv/bin/python" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 12))' 2>/dev/null; then
    rm -rf "$ROOT/.venv"
    "$PY" -m venv "$ROOT/.venv" >> "$LOG" 2>&1 || { say "Die Python-Umgebung (.venv) konnte nicht angelegt werden. Details: install.log"; exit 1; }
fi
VPY="$ROOT/.venv/bin/python"

if ! "$VPY" -c 'import PySide6.QtWidgets' 2>/dev/null; then
    PINS=$(grep -iE '^(pyside6-essentials|shiboken6)==' "$ROOT/requirements-lock-macos.txt" | tr '\n' ' ')
    mkdir -p "$ROOT/vendor/wheels"
    if ! "$VPY" -m pip install --quiet --no-index --find-links "$ROOT/vendor/wheels" $PINS >> "$LOG" 2>&1; then
        osascript -e 'display notification "Lade die Oberfläche für das Installationsfenster (~110 MB) …" with title "ODReview installieren"' 2>/dev/null
        "$VPY" -m pip download --quiet --only-binary=:all: -d "$ROOT/vendor/wheels" $PINS >> "$LOG" 2>&1 \
          && "$VPY" -m pip install --quiet --no-index --find-links "$ROOT/vendor/wheels" $PINS >> "$LOG" 2>&1 \
          || { say "Für das Installationsfenster fehlt Qt, und es konnte nicht geladen werden (Internet?).\n\nAlternative: install.command im Ordner doppelklicken (Terminal)."; exit 1; }
    fi
fi

exec "$VPY" "$ROOT/tools/installer_gui.py"
